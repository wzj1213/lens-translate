{
  "name": "lens-translate",
  "version": "1.0.0",
  "description": "A Chrome extension for bilingual page and selection translation.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "node build.mjs --watch",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
